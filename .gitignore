# configuration. They are never part of the public research release.
/**/AGENTS.md
/**/AGENT.md
/**/AGENT_GUIDE*.md
/**/AGENT_RULES*.md
/**/CLAUDE.md
/**/GEMINI.md
/**/CODEX.md
/**/COPILOT.md
/.github/copilot-instructions.md
/.cursor/

# Raw and derived research data are acquired and reproduced by documented scripts;
# retain only manifests and small, explicitly approved fixtures in version control.
/data/**/raw/
/data/**/processed/
/data/model_outputs/validated/
/data/study0/annotation/
/future_human_study/data/**/raw/
/future_human_study/data/**/processed/

# Local environments and rendered build artifacts.
.venv/
.env_vlm/
compute/model_cache/
compute/runtime_logs/
tmp/
__pycache__/
*.py[cod]
/paper/**/build/
/paper/**/*.aux
/paper/**/*.bbl
/paper/**/*.blg
/paper/**/*.log
/paper/**/*.out
/poster/**/build/

# Transient console captures; named, machine-readable result artifacts are kept.
/results/*_run_stdout.log
/results/*_run_stderr.log
/logs/inference_manifest.csv
/results/public_intervention_synthetic/
