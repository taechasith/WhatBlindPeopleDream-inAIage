# Private, author-identifying material. Never include in anonymous review packages.
/private/
/future_human_study/private/
/future_human_validation/private/
/annotation_public/private/
/annotation/locked/
/annotation/received/
/guides/archive/

# The supplied governing brief contains post-review author information. The
# anonymous, distribution-safe protocol is PROTOCOL.md.
/CHI2027_Blind_Dreams_AI_Research_Guide.md

# Local credentials, tokens, and machine-specific configuration. Keep an
# explicitly reviewed *.example file if a public template is needed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
secrets/
credentials/
.secrets/
.credentials/

